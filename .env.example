# =============================================================================
# Mini Inventory System — Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# PostgreSQL connection string (Neon / Supabase / Vercel Postgres compatible).
#
# Neon example (recommended for Vercel serverless):
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
#
# Supabase example:
#   DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Use the POOLED connection string for the serverless runtime (port 6543 on
# Supabase, the "-pooler" host on Neon). See README "Deployment" for details.
DATABASE_URL="postgresql://user:password@host:5432/inventory?sslmode=require"

# Optional: a direct (non-pooled) connection used by `prisma migrate`.
# Prisma migrations need a direct connection; pooled PgBouncer connections
# cannot run them. Point this at the direct host (Neon non-pooler / Supabase 5432).
# If omitted, DATABASE_URL is used for migrations too.
DIRECT_URL="postgresql://user:password@host:5432/inventory?sslmode=require"
